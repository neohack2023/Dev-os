{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "DevOS Evidence Episode",
  "type": "object",
  "additionalProperties": false,
  "required": ["episode_id", "branch_key", "claim_key", "observed_at", "current_claims", "roots", "findings"],
  "properties": {
    "episode_id": {"type": "string", "minLength": 1},
    "branch_key": {"type": "string", "minLength": 1},
    "claim_key": {"type": "string", "minLength": 1},
    "observed_at": {"type": "string", "minLength": 1},
    "current_claims": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["claim_id", "claim_key", "value"],
        "properties": {
          "claim_id": {"type": "string", "minLength": 1},
          "claim_key": {"type": "string", "minLength": 1},
          "value": {"type": "string", "minLength": 1},
          "lifecycle": {"type": "string"}
        }
      }
    },
    "roots": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": true,
        "required": ["root_id", "root_kind", "observation_question"],
        "properties": {
          "root_id": {"type": "string", "minLength": 1},
          "root_kind": {"type": "string", "minLength": 1},
          "observation_question": {"type": "string", "minLength": 1},
          "provenance_refs": {"type": "array", "items": {"type": "string"}}
        }
      }
    },
    "findings": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": true,
        "required": ["finding_id", "claim_key", "value", "evidence_ref"],
        "properties": {
          "finding_id": {"type": "string", "minLength": 1},
          "claim_key": {"type": "string", "minLength": 1},
          "value": {"type": "string", "minLength": 1},
          "evidence_ref": {"type": "string", "minLength": 1},
          "root_ids": {"type": "array", "items": {"type": "string"}},
          "lineage_state": {"type": "string"}
        }
      }
    }
  }
}
