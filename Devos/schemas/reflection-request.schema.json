{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "DevOS Reflection Request",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "branch_key",
    "expected_behavior",
    "mechanism_hypothesis",
    "evidence_for",
    "evidence_against",
    "alternative_explanations",
    "predicted_consequence",
    "required_disconfirmation_test",
    "proposed_scope"
  ],
  "properties": {
    "branch_key": {"type": "string", "minLength": 1},
    "expected_behavior": {"type": "string", "minLength": 1},
    "mechanism_hypothesis": {"type": "string", "minLength": 1},
    "evidence_for": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
    "evidence_against": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
    "alternative_explanations": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
    "predicted_consequence": {"type": "string", "minLength": 1},
    "required_disconfirmation_test": {"type": "string", "minLength": 1},
    "proposed_scope": {"type": "string", "minLength": 1}
  }
}
