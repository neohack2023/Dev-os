{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "promotion-request.schema.json",
  "title": "DevOS Promotion Request",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "observed_at", "capability_id", "candidate_revision", "change_digest", "target",
    "expected_benefit", "regression_risk", "falsification_test", "rollback_plan",
    "verification_plan", "required_authorization", "destination_authority"
  ],
  "properties": {
    "observed_at": {"type": "string", "minLength": 1},
    "capability_id": {"type": "string", "minLength": 1},
    "candidate_revision": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "change_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository", "branch", "paths", "change_ref"],
      "properties": {
        "repository": {"type": "string", "minLength": 1},
        "branch": {"type": "string", "minLength": 1},
        "paths": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "change_ref": {"type": "string", "minLength": 1}
      }
    },
    "expected_benefit": {"type": "string", "minLength": 1},
    "regression_risk": {"type": "string", "minLength": 1},
    "falsification_test": {"type": "string", "minLength": 1},
    "rollback_plan": {"type": "string", "minLength": 1},
    "verification_plan": {
      "type": "object",
      "additionalProperties": false,
      "required": ["required_checks"],
      "properties": {
        "required_checks": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["name", "source"],
            "properties": {
              "name": {"type": "string", "minLength": 1},
              "source": {"type": "string", "minLength": 1}
            }
          }
        },
        "require_independent_review": {"type": "boolean"},
        "review_source": {"type": "string"},
        "require_canary": {"type": "boolean"},
        "canary_source": {"type": "string"}
      }
    },
    "required_authorization": {"type": "string", "minLength": 1},
    "destination_authority": {"const": "repository"}
  }
}
